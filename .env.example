# ==============================================================================
# Saitring Employee Manager (SEMA) - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' in the project root and replace with your local values.
# DO NOT commit real secrets or production credentials.
# ==============================================================================

# Application Metadata
APP_NAME=saitring-employee-manager

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/saitring_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# Redis / Upstash Cache Configuration (OTP 2FA Challenges & Rate Limiting)
# Local Redis: redis://localhost:6379 or Upstash Cloud TLS: rediss://default:...@...upstash.io:6379
UPSTASH_REDIS_URL=redis://localhost:6379

# JWT Security Settings (HMAC-SHA256)
# Minimum 256 bits (32+ characters) cryptographically secure secret
APP_JWT_SECRET=replace_with_a_secure_random_base64_or_256_bit_secret_key_minimum_32_chars
APP_JWT_EXPIRATION_SECONDS=86400

# Brevo Email & SMS Notification Provider (Optional for local dev - simulation mode enabled if blank)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sema.servicesupport@gmail.com
BREVO_SENDER_NAME=Saitring Security
BREVO_SMS_SENDER=SAITRING

# Twilio SMS Notification Provider (Alternative to Brevo SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloud Object Storage (Supabase Storage for Organization Logos)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_BUCKET=organization-logos

# Alternative Object Storage (Amazon S3)
S3_BUCKET=sema-31
AWS_REGION=eu-north-1

# Cross-Origin Resource Sharing (CORS) Whitelist
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
